rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 玩家打開遊戲時會自動匿名登入，所以下面的 request.auth 一定有值。
    // 每個玩家自己的存檔：錢包、買過的東西、熟練度。只有本人能讀寫。
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // 排行榜：大家都看得到，只能改自己那一筆。
    match /players/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.earned is number
        && request.resource.data.served is number
        && request.resource.data.earned < 100000000
        && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 20));
    }
    // 作品牆：每人一筆，最多 8 張款式卡。
    match /gallery/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.items.size() <= 8
        && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 20));
    }
    // 按讚：每人一筆，記自己按過哪些作品。
    match /likes/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
